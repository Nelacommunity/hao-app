# Settings for scripts/vps/migrate-to-vps.sh. Copy to .vps.env.local in the project root (git-ignored)
# and fill in. Every value here is a secret: never commit the filled-in copy.
# In the *_DB_URL values, percent-encode special characters in the password (@ → %40, # → %23, / → %2F).

# ── Old: the hosted Supabase project ─────────────────────────────────────────
# Dashboard → Connect → Session pooler (IPv4). Use the database password, not an API key.
OLD_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Dashboard → Project Settings → API
OLD_API_URL=https://<project-ref>.supabase.co
OLD_SERVICE_KEY=

# ── New: Supabase on the VPS (docker compose, supabase/docker) ───────────────
# From the VPS's supabase/docker/.env: POSTGRES_PASSWORD, and POOLER_TENANT_ID for the user name.
# Port 5432 goes through Supavisor (session mode); open it only to your own IP while migrating.
NEW_DB_URL=postgresql://postgres.<pooler-tenant-id>:<postgres-password>@<vps-ip-or-host>:5432/postgres
# SUPABASE_PUBLIC_URL / API_EXTERNAL_URL from the VPS .env, served over https.
NEW_API_URL=https://supabase.<your-domain>
# SERVICE_ROLE_KEY from the VPS .env
NEW_SERVICE_KEY=

# ── For scripts/vps/deploy-function.sh ───────────────────────────────────────
# How you ssh into the VPS, and where its supabase/docker folder (with docker-compose.yml) is.
VPS_SSH=user@<vps-ip-or-host>
VPS_DOCKER_DIR=/opt/supabase/docker
# Coolify: the service's folder, /data/coolify/services/<uuid>
# The functions service in docker-compose.yml, if not "functions".
# VPS_FUNCTIONS_SERVICE=functions
# Coolify: the container's name from `docker ps` instead (restarted directly, compose is left to Coolify).
# VPS_FUNCTIONS_CONTAINER=functions-<uuid>

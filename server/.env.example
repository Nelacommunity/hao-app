# Server-only secrets. Never prefix with EXPO_PUBLIC_.
# qwen (default) or mock (canned replies, no key needed)
AI_PROVIDER=qwen
QWEN_API_KEY=
# Optional: region endpoint (default Singapore) and models; see the root .env.example
# QWEN_BASE_URL=
# QWEN_MODEL=qwen3.8-flash
# QWEN_AUDIO_MODEL=qwen3.8-omni-flash

PORT=8787
# Base of the URL inside the QR code. Phones must be able to open it:
#   LAN:    http://192.168.1.20:8787   (broadcast listeners work; the local's mic needs HTTPS)
#   Tunnel: https://xxxx.trycloudflare.com   (needed for the conversation mode mic)
PUBLIC_BASE_URL=http://localhost:8787

# Same Supabase project as the app, so only signed-in Hao users can create rooms.
SUPABASE_URL=
SUPABASE_KEY=

# Cost controls
AI_CALLS_PER_MINUTE=30
AI_CALLS_PER_ROOM=1500

# ── Live conversation rooms ──
# device (default): phones speak Hao's lines with their built-in voice (fastest).
# server: the AI provider generates Hao's voice (adds a few seconds per turn; falls back to the device voice).
ROOM_TTS=device
# QWEN_TTS_MODEL=qwen3-tts-flash
# QWEN_TTS_VOICE=Cherry
# Conversation rooms close after this many minutes without a turn.
ROOM_IDLE_MINUTES=5

# Server-only secrets. Never prefix with EXPO_PUBLIC_.
GEMINI_API_KEY=
# gemini (default) or mock (canned replies, no key needed)
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
# low keeps latency down; set empty to use the model default
GEMINI_THINKING_LEVEL=low
# Optional faster model for captions/translations (target: captions < 3 s), e.g.
#   GEMINI_FAST_MODEL=gemini-3.5-flash-lite
#   GEMINI_FAST_THINKING_LEVEL=minimal
GEMINI_FAST_MODEL=
GEMINI_FAST_THINKING_LEVEL=

PORT=8787
# Base of the URL inside the QR code. Phones must be able to open it:
#   LAN:    http://192.168.1.20:8787   (broadcast listeners work; the local's mic needs HTTPS)
#   Tunnel: https://xxxx.trycloudflare.com   (needed for the conversation mode mic)
PUBLIC_BASE_URL=http://localhost:8787

# Same Supabase project as the app, so only signed-in Hao users can create rooms.
SUPABASE_URL=
SUPABASE_KEY=

# Cost controls
AI_CALLS_PER_MINUTE=30
AI_CALLS_PER_ROOM=1500

# ── Live conversation rooms ──
# device (default): phones speak Hao's lines with their built-in voice (fastest).
# gemini: the server generates Hao's voice (adds ~4 s per turn; falls back to the device voice).
ROOM_TTS=device
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
# Conversation rooms close after this many minutes without a turn.
ROOM_IDLE_MINUTES=5

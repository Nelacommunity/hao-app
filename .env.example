# ── Supabase ── Project Settings → API (or `npx supabase status` for a local stack)
EXPO_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…) or the legacy anon key. Safe to ship in the app; RLS protects the data.
EXPO_PUBLIC_SUPABASE_KEY=
# Secret key (sb_secret_…, or the legacy service_role key). SERVER-ONLY, never prefix with EXPO_PUBLIC_.
# Lets the API save each language's AI translation of the app once, for everyone (table ui_translations).
SUPABASE_SECRET_KEY=

# ── Gemini ── https://aistudio.google.com/apikey  (server-only, never prefix with EXPO_PUBLIC_)
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
# Optional: speech-to-text, captions and quick translations (default gemini-3.5-flash-lite, thinking minimal)
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Optional: the live QR-room agent (default GEMINI_MODEL, thinking low)
# GEMINI_ROOM_MODEL=


# ── QR rooms (Supabase Realtime; no separate server) ── base URL other phones open from the QR code.
# Leave empty in development: the app uses the Expo dev server (start with `npx expo start --tunnel` for an
# https link, which the guest's microphone needs). In production, set your EAS Hosting URL.
EXPO_PUBLIC_WEB_URL=

# ── AMap (高德) ── place search and place details only. Server only, never shipped in the app.
# console.amap.com → 应用管理 → 创建Key, service platform "Web服务".
AMAP_KEY=

# ── Mapbox ── the map, street routes and the city Hao detects from GPS.
# account.mapbox.com → Tokens: a public token (pk.…). Shipped in the app; restrict its URLs there.
# The API routes use it too (Directions and Geocoding).
EXPO_PUBLIC_MAPBOX_TOKEN=

# ── Supabase ── Project Settings → API (or `npx supabase status` for a local stack)
EXPO_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…) or the legacy anon key. Safe to ship in the app; RLS protects the data.
EXPO_PUBLIC_SUPABASE_KEY=
# Secret key (sb_secret_…, or the legacy service_role key). SERVER-ONLY, never prefix with EXPO_PUBLIC_.
# Lets the API save each language's AI translation of the app once, for everyone (table ui_translations),
# store places (public.places) and read community stats for place recommendations. Also used by
# `npm run seed:places` (scripts/seed-places.mjs) from this local .env.
SUPABASE_SECRET_KEY=

# ── Auth emails (Resend) ── the sign-up verification code and password reset are sent by Supabase Auth through
# Resend's SMTP server, not by the app. resend.com → Domains (verify yours) → API Keys (a "Sending access" key).
# Local stack (`npx supabase start`): put these two in supabase/.env, which supabase/config.toml reads.
# Self-hosted (VPS): set them in the Supabase service's environment instead, see scripts/vps/README.md.
# RESEND_API_KEY=re_...
# AUTH_EMAIL_FROM=login@your-verified-domain.com

# ── AI (Qwen, Alibaba Cloud Model Studio) ── Model Studio → API keys (server-only, never prefix with EXPO_PUBLIC_).
QWEN_API_KEY=
# Optional: the OpenAI-compatible endpoint of the key's region (default Singapore,
# https://dashscope-intl.aliyuncs.com/compatible-mode/v1; Beijing is https://dashscope.aliyuncs.com/compatible-mode/v1).
# QWEN_BASE_URL=
# Optional: agent turns (default qwen3.8-flash), short translations (default qwen3.8-flash),
# live room turns (default QWEN_MODEL) and anything with audio (default qwen3.8-omni-flash)
# QWEN_MODEL=qwen3.8-flash
# QWEN_FAST_MODEL=qwen3.8-flash
# QWEN_ROOM_MODEL=
# QWEN_AUDIO_MODEL=qwen3.8-omni-flash
# Optional: let agent turns think first (better answers, slower)
# QWEN_THINKING=true

# ── QR rooms (Supabase Realtime; no separate server) ── base URL other phones open from the QR code.
# Leave empty in development: the app uses the Expo dev server (start with `npx expo start --tunnel` for an
# https link, which the guest's microphone needs). In production, set your EAS Hosting URL.
EXPO_PUBLIC_WEB_URL=

# ── Discover stories ── generated nightly by the generate-stories Edge Function, not by the Expo server.
# Set these as Edge Function secrets (`npx supabase secrets set NAME=value`), or for `npx supabase functions serve`
# in supabase/functions/.env. QWEN_API_KEY (and QWEN_BASE_URL if set) and AMAP_KEY above
# are needed there too.
# QWEN_STORY_MODEL=              # default: QWEN_MODEL, then qwen3.8-flash
# STORIES_MAX_CALLS=120          # per-run limit on model calls (an illustration counts as 4)
# STORIES_AUTO_APPROVE_ALL=true  # demo only: skip review for culture, place, food and community stories
# STORIES_AI_IMAGES=true         # illustrations for culture stories only, saved to the public story-images bucket
# QWEN_IMAGE_MODEL=              # default: qwen-image-3.0-pro
# STORIES_MOCK=true              # placeholder model and AMap: try the pipeline without any keys

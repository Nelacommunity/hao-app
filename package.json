    "eslint-config-expo": "~58.0.4",
    "leaflet": "^1.9.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "NODE_OPTIONS=--dns-result-order=ipv4first expo start",
    "android": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --android",
    "ios": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --ios",
    "web": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --web",
    "lint": "expo lint",
    "db:start": "npx supabase start",
    "db:push": "npx supabase db push",
    "db:types": "npx supabase gen types typescript --local > src/lib/database.types.ts",
    "kb:build": "node scripts/build-knowledge.mjs",
    "i18n:build": "node scripts/build-i18n.mjs",
    "map:build": "node scripts/build-map-assets.mjs",
    "db:test": "npx supabase test db",
    "test:ranking": "node --test \"shared/places/*.test.ts\"",
    "test:twin": "node --test \"shared/ai/twin.test.ts\"",
    "test:stories": "node --test \"shared/stories/*.test.ts\"",
    "seed:places": "node scripts/seed-places.mjs",
    "stories:facts": "node --no-warnings scripts/build-story-facts.mjs",
    "seed:stories": "node scripts/seed-stories.mjs",
    "demo:ranking": "node scripts/demo-ranking.mjs"
  },
  "private": true
}
